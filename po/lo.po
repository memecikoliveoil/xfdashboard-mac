#: data/org.xfce.xfdashboard.desktop.in.in:5
#: data/metainfo/org.xfce.xfdashboard.metainfo.xml.in:7
msgid "Maybe a Gnome shell like dashboard for Xfce"
msgstr "ບາງທີອາດເປັນແດຊບອດທີ່ຄ້າຍຄືກັບ GNOME shell ສຳລັບ Xfce"

#: data/org.xfce.xfdashboard-autostart.desktop.in.in:5
msgid "Start xfdashboard as daemon in background"
msgstr "ເລີ່ມຕົ້ນ xfdashboard ເປັນ daemon ໃນພື້ນຫຼັງ"

